# OpenBettingExchange configuration - copy to .env and adjust.
# All money is integer cents. Paper money only.
#
# Every knob the server reads is listed here, with the default it actually has.
# `npm run check:env-example` fails if this file drifts from the code in either
# direction — a key the code reads but this file omits, a value that no longer
# matches the default, or a leftover key the code no longer reads. Add the key
# HERE and in lib/config.js in the same change.
#
# A blank value is a real value here, not an omission: most of the operational
# knobs below default to "unset", and "unset" has a specific, deliberate meaning
# (secrets are refused, /metrics 404s, the scheduled backup does not run).
# Read the comment before filling one in.

# --- Server ----------------------------------------------------------------
PORT=7777
# Loopback only — anything else is a hard launch failure, not a warning.
HOST=127.0.0.1
DB_PATH=data/openbettingexchange.db
# The ONE currency the venue trades in (three-letter uppercase ISO 4217). It is
# recorded on every ledger account and on every payment intent, it is what
# /api/branding publishes, and it is what the browser's money formatter renders
# a symbol for — so changing it changes what players are shown and what the
# books mean. It was a hard-coded 'USD' written at eight sites into two columns
# nothing read before #104; it is read now, and a per-tenant value that differs
# from this one is refused rather than silently mixed.
#
# Set it BEFORE a venue takes money. Changing it on a database that already
# holds balances relabels them, including any payment intent still pending — see
# migrateVenueCurrency in lib/store.js.
#
# This is ONE currency, not a display preference. Setting it for a second
# currency per venue is not supported: the ledger has a single denomination and
# no FX rate anywhere in it. See docs/EXCHANGE_RULES.md.
VENUE_CURRENCY=AUD
# scrypt cost for password hashing. The default is OWASP's recommended floor
# (~160ms per login). Do not lower it in production; the tests do, for speed.
SCRYPT_N=65536
# Session lifetime, in days.
SESSION_TTL_DAYS=30

# --- Commission and stake limits (cents) -----------------------------------
# Fee charged on net winnings per user per market. Must be in [0, 0.2].
COMMISSION_RATE=0.025
# Faucet deposit cap per request.
FAUCET_MAX_CENTS=100000
MIN_STAKE_CENTS=100
MAX_STAKE_CENTS=100000
# Market-version materiality (#92): how many book-altering events (fill, cancel)
# on a selection or market are tolerated between the version a client read and
# the one it sends with its order before the venue refuses it as stale. Only
# affects clients that SEND a version; omitting one preserves the old behaviour
# exactly. 0 means "refuse on any movement". See docs/EXCHANGE_RULES.md.
MARKET_VERSION_MATERIAL_THRESHOLD=2

# --- Odds feed (betfair-market-snapshots) -----------------------------------
# When enabled, the board's prices come from the recorder's Postgres instead of
# the demo bots. Bots and drift are suppressed automatically when this is on,
# because two price sources would fight. See docs/FEED.md.
FEED_ENABLED=false
# Required whenever FEED_ENABLED=true; the app refuses to boot without it.
FEED_DATABASE_URL=postgresql://betfair:betfair@127.0.0.1:5432/betfair
# 1 = fixtures only, 2 = fixtures + prices + results.
FEED_NUMBER=2
# Seconds before a frame counts as stale. The recorder runs on a DELAYED
# Betfair key that batches on a ~3 minute cadence, so this sits a little over
# one cycle.
FEED_STALE_SECONDS=300
# Markets returned to the board, newest frame first.
FEED_MARKET_LIMIT=60
# Supervise the collector (spawn `betfeed collect` and restart it) instead of
# running it separately. Default off: a venue that already supervises the
# collector must not find a second copy writing the same rows.
FEED_RUNNER_ENABLED=false
# The collector command, split on whitespace. An absolute path works, and so
# does prefixing a wrapper (uv, podman, a systemd unit).
FEED_COLLECTOR_CMD=betfeed collect
# Seconds the supervisor waits after a credential change before restarting the
# collector. Non-zero on purpose: a wrong credential fails immediately and
# repeatedly, so retrying on every change turns an operator's typo into a login
# flood against Betfair.
FEED_RUNNER_MIN_UPTIME_SECONDS=120
# AES-256-GCM key for the collector's Betfair credentials, as 64 hex chars.
# Generate with:  openssl rand -hex 32
# LEAVE THIS BLANK AND THE VENUE REFUSES TO STORE A CREDENTIAL — it does not
# fall back to plaintext, and it will not start the runner.
FEED_CREDENTIALS_KEY=
# Set to 1 for the supervisor's stderr on the child process. Diagnostics only.
FEED_COLLECTOR_VERBOSE=0

# --- Market-maker risk (cents) ---------------------------------------------
# A missing risk row falls back to these, NOT to unlimited. An unconfigured
# market maker with no cap is precisely the unbounded-loss case these close.
RISK_MAX_LIABILITY_CENTS=5000000
# Realised daily loss floor for the bot.
RISK_MAX_DAILY_LOSS_CENTS=1000000
# Ticks of widening at full loss pressure, 0-1. ZERO GIVES A CLIFF, NOT A SLOPE.
RISK_QUOTE_SKEW=0.5
# Ticks of widening at RISK_QUOTE_SKEW=1 and full pressure.
RISK_MAX_SKEW_TICKS=20
# Demo liquidity bots and price drift — the exchange stays live without a trader.
BOT_ENABLED=true
DRIFT_ENABLED=true
DRIFT_INTERVAL_MS=5000

# --- Cash-out --------------------------------------------------------------
# The VENUE quotes the buyout from its own fair prices minus this margin. It is
# the venue's edge: a market hedge has none, because hedging a multi-runner
# position is provably value-destroying.
CASHOUT_ENABLED=true
# 200bps = 2%.
CASHOUT_MARGIN_BPS=200
# Total unpaid cash-out exposure ($20k).
CASHOUT_MAX_OUTSTANDING_CENTS=2000000
# TOTAL CASHOUT OUTLAY today ($5k) — outlay, NOT realised loss. The player picks
# when to take the offer and takes it when the venue is worst exposed, so the
# bound has to be on money actually out, which is known at decision time.
# (Realised loss is still computed, for the desk's reporting.)
CASHOUT_MAX_DAILY_LOSS_CENTS=500000

# --- Responsible gambling --------------------------------------------------
# 0 means NOT CONFIGURED, not "unlimited but enforced": there is no session
# limit that is right for every operator. The server warns at boot when all
# three are unset, because a demo reaching production unguarded is the failure
# this exists to prevent.
RG_SESSION_MINUTES=0
# Idle gap after which a NEW sign-in starts a FRESH session. The session clock
# is never reset by signing out — that made the limit defeatable in one click,
# and because the clock is per-user, one logout used to clear it for every
# other live session too. Walking away and coming back is the only reset.
RG_SESSION_IDLE_RESET_MINUTES=15
RG_REALITY_CHECK_MINUTES=0
# Rolling 24-hour deposit limit.
RG_DEPOSIT_DAILY_CENTS=0

# --- Deposit limits (cents) ------------------------------------------------
# Caps on the CONFIRMATION path, not just the faucet route — the outside audit's
# critical finding was a player-confirmable deposit with no cap on confirmation.
# These bound the blast radius of any confirmation path, including a
# compromised webhook.
DEPOSIT_MAX_CENTS=100000
DEPOSIT_DAILY_MAX_CENTS=500000
# HMAC secret for POST /api/payments/webhook.
# LEAVE THIS BLANK AND THE WEBHOOK 404s — a confirmable deposit path with no
# authentication is exactly the critical bug the audit found.
PAYMENTS_WEBHOOK_SECRET=

# --- Request rate limits, per user per minute ------------------------------
# A tuning knob, not a law: a scalper legitimately fires many orders, and an
# operator should be able to raise a bound they set without a code change.
# 0 disables that bucket entirely, which is how the load test measures the
# ENGINE rather than the limiter.
#
# AUTH is keyed on the SOURCE ADDRESS rather than a user, because neither
# credential route has a session yet. It bounds how much key-derivation an
# unauthenticated caller can ask for; the per-username and per-address FAILURE
# counters still handle guessing.
RATE_LIMIT_AUTH=60
RATE_LIMIT_TRADE=120
RATE_LIMIT_CASHOUT=30
RATE_LIMIT_ADMIN=240
RATE_LIMIT_WALLET=60
RATE_LIMIT_READ=600

# --- Operations ------------------------------------------------------------
# Concurrent SSE streams. Each is a held socket the server writes to
# periodically, so this is a real memory ceiling — but it is also the difference
# between a live board and a dead one, which is why it is not 100.
MAX_SSE_CLIENTS=2000
# Per-CALLER bounds on the same pool. A single global cap is a lottery: every
# stream costs the venue the same and an unauthenticated one returns only
# public book frames, so one script could open all of them.
# PER_SOURCE bounds ANONYMOUS streams from one address, and counts anonymous
# streams only — counting every stream from the address would let a flood lock
# out the player behind the same NAT.
# PER_USER bounds streams bound to one account.
# A fifth of the pool is reserved for signed-in players regardless.
# 0 disables a bound.
MAX_SSE_CLIENTS_PER_SOURCE=20
MAX_SSE_CLIENTS_PER_USER=8
# Bearer token for /metrics and the backup control. UNSET MEANS BOTH RETURN 404
# rather than leaking balances to anyone who can reach the port. /healthz and
# /readyz stay open, because a supervisor has to reach them.
OPS_TOKEN=
# Where snapshots live. LEAVE THIS BLANK AND THE SCHEDULED BACKUP DOES NOT RUN;
# the boot log says so rather than silently never backing up. NOTE: a snapshot
# contains the users table, so it contains every scrypt password hash, and it is
# written with SQLite's default (world-readable) file mode. Keep BACKUP_DIR on a
# private filesystem. See #4.
BACKUP_DIR=
# Snapshots kept before the oldest is pruned.
BACKUP_RETENTION=24
# Scheduled backup cadence, milliseconds (default 6 hours).
BACKUP_INTERVAL_MS=21600000
# WAL checkpoint + incremental vacuum cadence, milliseconds (default 1 hour).
MAINTENANCE_INTERVAL_MS=3600000
# Scheduled reconciliation cadence, milliseconds (default 15 minutes).
RECONCILE_INTERVAL_MS=900000
# Release of expired delays into the book, milliseconds; 0 disables.
DELAY_RELEASE_INTERVAL_MS=5000

# --- Results feed transport ------------------------------------------------
# The venue POSTs its pending markets here and expects outcomes back. Unset
# means the venue settles by hand or by webhook, which is a legitimate way to
# run — but RESULTS_POLL_INTERVAL_MS without this is a knob that does nothing,
# and the boot log says so.
RESULTS_FEED_URL=
# Sent as `Authorization: Bearer`. A feed with no secret is allowed but the
# endpoint decides who gets paid, so boot warns loudly if the URL is set alone.
RESULTS_FEED_SECRET=
# Per-poll timeout, so a hung feed cannot stall the job.
RESULTS_FEED_TIMEOUT_MS=10000
RESULTS_POLL_INTERVAL_MS=60000
# Log verbosity for the feed credential admin surface (INFO, DEBUG, ...).
LOG_LEVEL=INFO

# --- Jurisdiction ----------------------------------------------------------
# Off by default, and the country header is IGNORED while it is off: a
# client-declared country is not a jurisdiction, and trusting one would make the
# control defeatable by editing a header while still being recorded as enforced.
# Turn on ONLY when every request provably passed through an edge that OVERWRITES
# the header. lib/config.js pins HOST to loopback, so the intended deployment
# (app behind a reverse proxy) is what makes that true.
TRUST_PROXY_JURISDICTION=false

# --- Seeded demo credentials -----------------------------------------------
# Overrides for the accounts lib/seed.js creates on FIRST RUN only. Blank means
# keep the seeded defaults (admin123 / demo123), and the server warns loudly at
# boot for as long as those remain active. Change them before exposing anything.
ADMIN_PASSWORD=
DEMO_PASSWORD=