# OpenBookmaker configuration - copy to .env and adjust.
# All money is integer cents. Paper money only.

# Server
PORT=7777
HOST=127.0.0.1
DB_PATH=data/openbookmaker.db

# Commission charged on net winnings per user per market (0 - 0.2)
COMMISSION_RATE=0.025

# --- Odds feed (betfair-market-snapshots) -----------------------------------
# When enabled, the board's prices come from the recorder's Postgres instead of
# the demo bots. Bots and drift are suppressed automatically when this is on,
# because two price sources would fight. See docs/FEED.md.
FEED_ENABLED=false
FEED_DATABASE_URL=postgresql://betfair:betfair@127.0.0.1:5432/betfair
# A frame older than this is reported stale rather than served as live. The
# recorder uses a DELAYED Betfair key, which batches on a ~3 minute cadence, so
# the default sits a little over one cycle.
FEED_STALE_SECONDS=300
# Markets returned to the board, newest frame first.
FEED_MARKET_LIMIT=60

# Faucet deposit cap per request (cents)
FAUCET_MAX_CENTS=100000

# Bet size limits (cents)
MIN_STAKE_CENTS=100
MAX_STAKE_CENTS=100000

# Demo liquidity bots + price drift (the exchange stays live without a trader)
BOT_ENABLED=true
DRIFT_ENABLED=true
DRIFT_INTERVAL_MS=5000

# Sessions
SESSION_TTL_DAYS=30
