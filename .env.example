# OpenBettingExchange configuration - copy to .env and adjust.
# All money is integer cents. Paper money only.
#
# Every knob the server reads is listed here, with the default it actually has.
# `npm run check:env-example` fails if this file drifts from the code in either
# direction — a key the code reads but this file omits, a value that no longer
# matches the default, or a leftover key the code no longer reads. Add the key
# HERE and in lib/config.js in the same change.
#
# A blank value is a real value here, not an omission: most of the operational
# knobs below default to "unset", and "unset" has a specific, deliberate meaning
# (secrets are refused, /metrics 404s, the scheduled backup does not run).
# Read the comment before filling one in.

# --- Server ----------------------------------------------------------------
PORT=7777
# Loopback only — anything else is a hard launch failure, not a warning.
HOST=127.0.0.1
DB_PATH=data/openbettingexchange.db
# The ONE currency the venue trades in (three-letter uppercase ISO 4217). It is
# recorded on every ledger account and on every payment intent, it is what
# /api/branding publishes, and it is what the browser's money formatter renders
# a symbol for — so changing it changes what players are shown and what the
# books mean. It was a hard-coded 'USD' written at eight sites into two columns
# nothing read before #104; it is read now, and a per-tenant value that differs
# from this one is refused rather than silently mixed.
#
# Set it BEFORE a venue takes money. Changing it on a database that already
# holds balances relabels them, including any payment intent still pending — see
# migrateVenueCurrency in lib/store.js.
#
# This is ONE currency, not a display preference. Setting it for a second
# currency per venue is not supported: the ledger has a single denomination and
# no FX rate anywhere in it. See docs/EXCHANGE_RULES.md.
VENUE_CURRENCY=AUD
# scrypt cost for password hashing. The default is OWASP's recommended floor
# (~160ms per login). Do not lower it in production; the tests do, for speed.
SCRYPT_N=65536
# Session lifetime, in days.
SESSION_TTL_DAYS=30

# --- Commission and stake limits (cents) -----------------------------------
# Fee charged on net winnings per user per market. Must be in [0, 0.2].
COMMISSION_RATE=0.025
# Faucet deposit cap per request.
FAUCET_MAX_CENTS=100000
MIN_STAKE_CENTS=100
MAX_STAKE_CENTS=100000
# Market-version materiality (#92): how many book-altering events (fill, cancel)
# on a selection or market are tolerated between the version a client read and
# the one it sends with its order before the venue refuses it as stale. Only
# affects clients that SEND a version; omitting one preserves the old behaviour
# exactly. 0 means "refuse on any movement". See docs/EXCHANGE_RULES.md.
MARKET_VERSION_MATERIAL_THRESHOLD=2

# --- Odds feed (betfair-market-snapshots) -----------------------------------
# When enabled, the board's prices come from the recorder's Postgres instead of
# the demo bots. Bots and drift are suppressed automatically when this is on,
# because two price sources would fight. See docs/FEED.md.
FEED_ENABLED=false
# Required whenever FEED_ENABLED=true; the app refuses to boot without it.
FEED_DATABASE_URL=postgresql://betfair:betfair@127.0.0.1:5432/betfair
# 1 = fixtures only, 2 = fixtures + prices + results.
FEED_NUMBER=2
# Which implementation of the feed contract serves the board:
#   postgres  the collector's v_feed1/v_feed2 views (this is the default, and it
#             is byte-for-byte the behaviour this venue had before the seam)
#   http      the operator's OWN JSON-over-HTTP feed API. The keys below are
#             inert unless this is `http`.
# An adapter that half-works produces wrong prices rather than an error, so
# FEED_PROVIDER=http is only supported alongside
# tests/feedprovider-conformance.test.js, which every provider must pass. That is
# a REVIEW gate, not a runtime one: declaring a provider in lib/feed/provider.js
# does not run the suite, it puts the provider in front of a reviewer who runs it.
FEED_PROVIDER=postgres
# --- HTTP feed provider (only read when FEED_PROVIDER=http) -------------------
# Base URL of the feed API. REQUIRED when FEED_PROVIDER=http — the app refuses
# to boot without it — and must be an http(s):// URL with no credentials in it
# (use FEED_HTTP_TOKEN instead). The resource paths are appended to it verbatim,
# so a base URL with a path (https://example.com/v2/feed) works.
FEED_HTTP_URL=
# Resource paths. `{id}` in the market path is replaced, percent-encoded; with no
# placeholder the id is appended as `?id=`.
FEED_HTTP_BOARD_PATH=/board
FEED_HTTP_MARKET_PATH=/market
# The nav tree is built from the CATALOGUE, not from the capped board: a tree
# built from a board limited to FEED_MARKET_LIMIT markets is a tree with most of
# the sport missing from it.
FEED_HTTP_CATALOGUE_PATH=/catalogue
FEED_HTTP_HEALTH_PATH=/health
# Bearer token. Sent as `Authorization: Bearer …` and NEVER logged, echoed in an
# error or published by a route. Leave blank for an API behind the venue's own
# edge — that is a legitimate deployment, and the app warns rather than refuses.
FEED_HTTP_TOKEN=
# A static header, for vendors that authenticate with `X-Api-Key` and friends
# rather than a bearer token. The value is a credential in every real
# deployment, which is why it ships blank here.
FEED_HTTP_HEADER_NAME=
FEED_HTTP_HEADER_VALUE=
# One attempt per request, then this timeout. There is deliberately NO retry
# loop: retrying a feed that is already slow turns one slow upstream into N
# concurrent slow upstreams and the venue pays for it in sockets.
FEED_HTTP_TIMEOUT_MS=10000
# In-flight requests, capped. The collector path was implicitly bounded by
# `new Pool({ max: 4 })`; HTTP had no bound at all, so an unauthenticated flood
# opened one socket per request to YOUR feed API, each able to buffer 8 MiB.
# 4 matches what the collector had. Raise it for a fast local API, lower it for a
# slow link — but it is a number, and it cannot be 0 (0 would silently restore the
# unbounded fan-out this exists to remove).
FEED_HTTP_MAX_CONCURRENCY=4
# …and a BOUNDED queue. Past this, callers are refused immediately with the
# provider's normal generic 503 rather than waiting for ever: an unbounded queue is
# the same exhaustion with a longer fuse. A wait is bounded by FEED_HTTP_TIMEOUT_MS,
# so one request cannot spend two budgets.
FEED_HTTP_MAX_QUEUE=16
# Does this feed carry prices at all? `false` is a fixtures-only catalogue: it
# renders with empty ladders and reads as stale, exactly like FEED_NUMBER=1.
FEED_HTTP_PRICED=true
# Multiplied into every ladder size before it reaches the shaper. The canonical
# unit is POUNDS — Betfair's — so a vendor publishing CENTS sets 0.01. Getting
# this wrong is a 100x error on every stake shown to a bettor, which is why it
# is a stated multiplier and not something the mapper guesses at.
FEED_HTTP_SIZE_SCALE=1
# THE FIELD MAPS, and they are the whole point of this provider.
#
# `key=path,key=path`, dotted paths, and a bare `key` meaning `key=key`. The key
# is a CANONICAL feed field — the column the collector's views project, which is
# what lib/feed/shape.js reads — and the path is where that field lives in YOUR
# JSON. The defaults below are the identity map, so a vendor whose API is already
# Betfair-shaped needs no configuration at all; the point of writing them out is
# that it doubles as the list of every field you may rename.
#
# They are PARSED AT BOOT by the provider's own parser: an empty map, an unknown
# field, an empty entry, a duplicate, or a missing required field all ABORT the
# launch. That is deliberate. A misconfigured map yields markets with no id, no
# name and no runners, which render as an empty board — and an empty board looks
# like a quiet Tuesday, not like a misconfiguration.
FEED_HTTP_MAP_BOARD=markets=markets,market_id=market_id,market_name=market_name,market_start_time=market_start_time,market_status=market_status,fixture_id=fixture_id,event_name=event_name,sport_slug=sport_slug,event_type_id=event_type_id,event_type_name=event_type_name,competition_id=competition_id,competition_name=competition_name,country_code=country_code,fixture_venue=fixture_venue,market_type_code=market_type_code,market_venue=market_venue,is_resolved=is_resolved,total_matched=total_matched,inplay=inplay,bet_delay=bet_delay,publish_time=publish_time,odds_captured_at=odds_captured_at,runners=runners,selection_id=selection_id,runner_name=runner_name,sort_priority=sort_priority,handicap=handicap,selection_status=selection_status,odds=odds,back=back,lay=lay,price=price,size=size,last_price_traded=last_price_traded
FEED_HTTP_MAP_NAV=markets=markets,market_id=market_id,market_name=market_name,market_time=market_time,market_type=market_type,market_status=market_status,number_of_winners=number_of_winners,sport=sport,sport_id=sport_id,sport_name=sport_name,country=country,competition=competition,event_id=event_id,event_name=event_name,event_time=event_time,in_play=in_play
FEED_HTTP_MAP_HEALTH=markets=markets,markets_with_odds=markets_with_odds,resolved=resolved,newest_book=newest_book,oldest_book=oldest_book,newest_publish=newest_publish
# Seconds before a frame counts as stale. The recorder runs on a DELAYED
# Betfair key that batches on a ~3 minute cadence, so this sits a little over
# one cycle.
FEED_STALE_SECONDS=300
# Markets returned to the board, newest frame first.
FEED_MARKET_LIMIT=60
# --- Materialising the feed's catalogue into the venue's own book -------------
# Nothing here is read until you run POST /api/admin/feed/sync. The feed stays
# display-only on its own: these keys bound that one operator action, they do
# not enable it.
#
# Markets ONE sync may materialise. The catalogue is 1400+ markets on a real
# feed and each one costs a market() round trip, so a run is bounded, says how
# much of the catalogue it did not read, and resumes from that offset.
FEED_BOOK_SYNC_LIMIT=200
# How many market() calls may be in flight at once — pressure on the licensed
# provider's API. Lower it on a small feed; nothing about the sync's correctness
# depends on the width.
FEED_BOOK_SYNC_CONCURRENCY=4
# The price a NEWLY materialised selection is seeded with. This is the VENUE's
# starting price, never the feed's: even money, a neutral position rather than a
# view. A feed price is NEVER copied into fair_price or ltp (docs/FEED.md
# explains why that is a money bug rather than a wrong number), and an existing
# selection's fair_price is never rewritten by a re-sync. The launch price model
# is an operator decision (#110/#108), not one this repository makes for you.
# Decimal odds — 2 is even money (a 1.00 stake returns 2.00 including stake).
FEED_BOOK_SEED_PRICE=2
# Supervise the collector (spawn `betfeed collect` and restart it) instead of
# running it separately. Default off: a venue that already supervises the
# collector must not find a second copy writing the same rows.
FEED_RUNNER_ENABLED=false
# The collector command, split on whitespace. An absolute path works, and so
# does prefixing a wrapper (uv, podman, a systemd unit).
FEED_COLLECTOR_CMD=betfeed collect
# Seconds the supervisor waits after a credential change before restarting the
# collector. Non-zero on purpose: a wrong credential fails immediately and
# repeatedly, so retrying on every change turns an operator's typo into a login
# flood against Betfair.
FEED_RUNNER_MIN_UPTIME_SECONDS=120
# AES-256-GCM key for the collector's Betfair credentials, as 64 hex chars.
# Generate with:  openssl rand -hex 32
# LEAVE THIS BLANK AND THE VENUE REFUSES TO STORE A CREDENTIAL — it does not
# fall back to plaintext, and it will not start the runner.
FEED_CREDENTIALS_KEY=
# Set to 1 for the supervisor's stderr on the child process. Diagnostics only.
FEED_COLLECTOR_VERBOSE=0

# --- Market-maker risk (cents) ---------------------------------------------
# A missing risk row falls back to these, NOT to unlimited. An unconfigured
# market maker with no cap is precisely the unbounded-loss case these close.
RISK_MAX_LIABILITY_CENTS=5000000
# Realised daily loss floor for the bot.
RISK_MAX_DAILY_LOSS_CENTS=1000000
# Ticks of widening at full loss pressure, 0-1. ZERO GIVES A CLIFF, NOT A SLOPE.
RISK_QUOTE_SKEW=0.5
# Ticks of widening at RISK_QUOTE_SKEW=1 and full pressure.
RISK_MAX_SKEW_TICKS=20
# Demo liquidity bots and price drift — the exchange stays live without a trader.
BOT_ENABLED=true
DRIFT_ENABLED=true
DRIFT_INTERVAL_MS=5000

# --- Cash-out --------------------------------------------------------------
# The VENUE quotes the buyout from its own fair prices minus this margin. It is
# the venue's edge: a market hedge has none, because hedging a multi-runner
# position is provably value-destroying.
CASHOUT_ENABLED=true
# 200bps = 2%.
CASHOUT_MARGIN_BPS=200
# Total unpaid cash-out exposure ($20k).
CASHOUT_MAX_OUTSTANDING_CENTS=2000000
# TOTAL CASHOUT OUTLAY today ($5k) — outlay, NOT realised loss. The player picks
# when to take the offer and takes it when the venue is worst exposed, so the
# bound has to be on money actually out, which is known at decision time.
# (Realised loss is still computed, for the desk's reporting.)
CASHOUT_MAX_DAILY_LOSS_CENTS=500000

# --- Responsible gambling --------------------------------------------------
# 0 means NOT CONFIGURED, not "unlimited but enforced": there is no session
# limit that is right for every operator. The server warns at boot when all
# three are unset, because a demo reaching production unguarded is the failure
# this exists to prevent.
RG_SESSION_MINUTES=0
# Idle gap after which a NEW sign-in starts a FRESH session. The session clock
# is never reset by signing out — that made the limit defeatable in one click,
# and because the clock is per-user, one logout used to clear it for every
# other live session too. Walking away and coming back is the only reset.
RG_SESSION_IDLE_RESET_MINUTES=15
RG_REALITY_CHECK_MINUTES=0
# Rolling 24-hour deposit limit.
RG_DEPOSIT_DAILY_CENTS=0

# --- Customer pre-verification (Australian AML/CTF) -------------------------
# Australian law has required identity verification BEFORE an online gambling
# account is created since 29 September 2024, and the interim allowance for
# deferring it in special circumstances was REPEALED rather than extended.
#
# false here is a statement about THIS REPOSITORY — paper money, seeded demo
# credentials — not about an Australian deployment. The server prints a loud
# warning at boot while this is false, every time.
#
# Setting this true with no IDENTITY_PROVIDER ABORTS THE LAUNCH rather than
# serving a mock that passes anyone. Same stance as FEED_CREDENTIALS_KEY:
# "not configured" is refused, never quietly treated as "allowed".
IDENTITY_REQUIRED=false
# Which registered provider to select. Blank means the reference provider, which
# is only ever correct for a paper-money install.
IDENTITY_PROVIDER=
# HMAC secret for the identity provider's decision callback. That callback is
# the only automated path that writes a decision. LEAVE BLANK AND IT 404s —
# an unauthenticated path that decides whether a customer may trade is a hole,
# not a callback.
IDENTITY_CALLBACK_SECRET=

# --- AML / CTF monitoring (AUSTRAC) -----------------------------------------
# THE VENUE'S OWN DECLARATION OF WHAT IT IS, and the switch the compliance
# apparatus hangs off.
#
# A paper-money install has no payment instruments at all — every deposit is
# synthetic — so a control that refuses a deposit whose funding instrument is not
# registered would refuse EVERY deposit on a venue where there is nothing to
# register. That is a bug, not a control, and the same is true of a $5,000
# threshold obligation raised against paper money.
#
# false here is a statement about THIS REPOSITORY, not about an Australian
# deployment. The server prints a loud warning at boot while it is false.
REGULATED_DEPLOYMENT=false
# Off by default, and announced at boot. Nothing about this repository's shape
# makes monitoring the right default; what makes it wrong is that a monitoring
# system which is off and unannounced reads as one which is on and quiet.
AML_MONITORING_ENABLED=false
# How often the AML pass runs, in MILLISECONDS. 0 disables the timer. Read
# straight from the environment by server.js rather than through lib/config.js,
# like every other interval here — these are operational knobs, not compliance
# posture. One hour by default: node:sqlite is synchronous and lib/aml/rules.js
# caps every rule's lookback for exactly that reason.
AML_SCAN_INTERVAL_MS=3600000
# The customer-due-diligence exemption threshold, in cents. AUD 5,000 is the
# figure that applies from 31 March 2026; it was AUD 10,000 before that.
#
# A transaction crossing it does not log: it creates a DURABLE OBLIGATION that
# re-surfaces until a human discharges it with a written reason.
AML_THRESHOLD_CENTS=500000
# Countries the venue will NOT accept funding or payouts from. Comma-separated
# ISO-3166 alpha-2. BLANK IS A REAL STATE and means "you have no restricted
# list", which the server says out loud when monitoring is on.
#
# No default list ships with this repository, for the reason lib/tenants.js
# refuses to ship an ISO currency registry: a stale regulatory list is a control
# that is confidently wrong, and the operator holding the licence knows the
# current one. We ship the check.
AML_RESTRICTED_JURISDICTIONS=
# Refuse a deposit whose funding instrument is not in the registered-instrument
# registry. True by default, and the reason is the Osko trap: on the NPP/Osko
# rail the operator's receiving PayID is normally registered to a payment
# PROCESSOR, not to the venue — so a naive name-match would refuse every
# legitimate Australian deposit. An instrument with an UNSTATED owner is the
# third-party case by definition, and NPP transfers are irrevocable with no
# chargeback, so intake is the only place it can be stopped.
FUNDING_REFUSE_UNREGISTERED=true

# --- Data-source register (Racing NSW and equivalents) ----------------------
# Racing NSW's rules require an approval from Racing NSW to use NSW race-field
# information REGARDLESS OF WHERE THE OPERATOR IS DOMICILES OR LICENSED, with
# fees payable — so "we are licensed somewhere else" is not an answer, and the
# venue needs a register of who owns each source, what approval is held, what it
# may be used for (display / store / settle) and when it expires.
#
# Days before an expiry that the register starts WARNING. A warning, not a
# refusal: the operator knows whether a renewal is in flight. The refusal is the
# licence being expired, which is unambiguous.
DATA_SOURCE_EXPIRY_WARN_DAYS=30

# --- Deposit limits (cents) ------------------------------------------------
# Caps on the CONFIRMATION path, not just the faucet route — the outside audit's
# critical finding was a player-confirmable deposit with no cap on confirmation.
# These bound the blast radius of any confirmation path, including a
# compromised webhook.
DEPOSIT_MAX_CENTS=100000
DEPOSIT_DAILY_MAX_CENTS=500000
# HMAC secret for POST /api/payments/webhook.
# LEAVE THIS BLANK AND THE WEBHOOK 404s — a confirmable deposit path with no
# authentication is exactly the critical bug the audit found.
PAYMENTS_WEBHOOK_SECRET=

# --- Request rate limits, per user per minute ------------------------------
# A tuning knob, not a law: a scalper legitimately fires many orders, and an
# operator should be able to raise a bound they set without a code change.
# 0 disables that bucket entirely, which is how the load test measures the
# ENGINE rather than the limiter.
#
# AUTH is keyed on the SOURCE ADDRESS rather than a user, because neither
# credential route has a session yet. It bounds how much key-derivation an
# unauthenticated caller can ask for; the per-username and per-address FAILURE
# counters still handle guessing.
RATE_LIMIT_AUTH=60
RATE_LIMIT_TRADE=120
RATE_LIMIT_CASHOUT=30
RATE_LIMIT_ADMIN=240
RATE_LIMIT_WALLET=60
RATE_LIMIT_READ=600
# The results webhook is the one ingress with no session behind it, so it keys on
# the SOURCE ADDRESS. Its own bucket rather than the wallet one: a signed-looking
# flood is a denial of service even when none of it verifies, and a knob named for
# one thing should not decide another.
RATE_LIMIT_RESULTS_WEBHOOK=120

# --- Operations ------------------------------------------------------------
# Concurrent SSE streams. Each is a held socket the server writes to
# periodically, so this is a real memory ceiling — but it is also the difference
# between a live board and a dead one, which is why it is not 100.
MAX_SSE_CLIENTS=2000
# Per-CALLER bounds on the same pool. A single global cap is a lottery: every
# stream costs the venue the same and an unauthenticated one returns only
# public book frames, so one script could open all of them.
# PER_SOURCE bounds ANONYMOUS streams from one address, and counts anonymous
# streams only — counting every stream from the address would let a flood lock
# out the player behind the same NAT.
# PER_USER bounds streams bound to one account.
# A fifth of the pool is reserved for signed-in players regardless.
# 0 disables a bound.
MAX_SSE_CLIENTS_PER_SOURCE=20
MAX_SSE_CLIENTS_PER_USER=8
# Bearer token for /metrics and the backup control. UNSET MEANS BOTH RETURN 404
# rather than leaking balances to anyone who can reach the port. /healthz and
# /readyz stay open, because a supervisor has to reach them.
OPS_TOKEN=
# Where snapshots live. LEAVE THIS BLANK AND THE SCHEDULED BACKUP DOES NOT RUN;
# the boot log says so rather than silently never backing up. NOTE: a snapshot
# contains the users table, so it contains every scrypt password hash, and it is
# written with SQLite's default (world-readable) file mode. Keep BACKUP_DIR on a
# private filesystem. See #4.
BACKUP_DIR=
# Snapshots kept before the oldest is pruned.
BACKUP_RETENTION=24
# Scheduled backup cadence, milliseconds (default 6 hours).
BACKUP_INTERVAL_MS=21600000
# WAL checkpoint + incremental vacuum cadence, milliseconds (default 1 hour).
MAINTENANCE_INTERVAL_MS=3600000
# Scheduled reconciliation cadence, milliseconds (default 15 minutes).
RECONCILE_INTERVAL_MS=900000
# Release of expired delays into the book, milliseconds; 0 disables.
DELAY_RELEASE_INTERVAL_MS=5000
# The LAPSE sweep: cancels unmatched LAPSE orders when their market turns
# in-play, milliseconds; 0 disables (and warns at boot). SEPARATE from
# DELAY_RELEASE_INTERVAL_MS on purpose — time in force is an order-lifecycle
# promise, and it must not die because an operator turned the in-play delay
# pass off.
LAPSE_INTERVAL_MS=5000

# --- Results feed transport ------------------------------------------------
# The venue POSTs its pending markets here and expects outcomes back. Unset
# means the venue settles by hand or by webhook, which is a legitimate way to
# run — but RESULTS_POLL_INTERVAL_MS without this is a knob that does nothing,
# and the boot log says so.
RESULTS_FEED_URL=
# Sent as `Authorization: Bearer`. A feed with no secret is allowed but the
# endpoint decides who gets paid, so boot warns loudly if the URL is set alone.
RESULTS_FEED_SECRET=
# HMAC secret for POST /api/results/webhook — the PUSH transport, and the one a
# licensed data feed is built for: the feed publishes outcomes and would rather
# push them than serve a queue the venue polls.
# LEAVE THIS BLANK AND THE WEBHOOK 404s. An unsigned POST to this route is not a
# results feed, it is a remote "settle this market" control with no
# authentication on it — and the boot log says which transports are live.
RESULTS_WEBHOOK_SECRET=
# Per-poll timeout, so a hung feed cannot stall the job.
RESULTS_FEED_TIMEOUT_MS=10000
RESULTS_POLL_INTERVAL_MS=60000
# Log verbosity for the feed credential admin surface (INFO, DEBUG, ...).
LOG_LEVEL=INFO

# --- Jurisdiction ----------------------------------------------------------
# Off by default, and the country header is IGNORED while it is off: a
# client-declared country is not a jurisdiction, and trusting one would make the
# control defeatable by editing a header while still being recorded as enforced.
# Turn on ONLY when every request provably passed through an edge that OVERWRITES
# the header. lib/config.js pins HOST to loopback, so the intended deployment
# (app behind a reverse proxy) is what makes that true.
TRUST_PROXY_JURISDICTION=false

# --- Seeded demo credentials -----------------------------------------------
# Overrides for the accounts lib/seed.js creates on FIRST RUN only. Blank means
# keep the seeded defaults (admin123 / demo123), and the server warns loudly at
# boot for as long as those remain active. Change them before exposing anything.
ADMIN_PASSWORD=
DEMO_PASSWORD=