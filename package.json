{
  "name": "openbettingexchange",
  "version": "0.1.0",
  "description": "Open-source Betfair-style betting exchange - back/lay order book, matching engine, tick-ladder pricing, cash-out. Paper money only.",
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings server.js",
    "seed": "node --no-warnings lib/seed.js",
    "test": "node tests/run_all.js",
    "test:smoke": "./tests/smoke.sh",
    "test:ui": "node tests/ui_test.mjs",
    "shots": "node scripts/shoot.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "check:ignore": "node scripts/check-gitignore.mjs",
    "check:env-example": "node scripts/check-env-example.mjs",
    "check:pins": "node scripts/check-action-pins.mjs",
    "load": "node scripts/load-test.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "betting-exchange",
    "betfair",
    "order-book",
    "matching-engine",
    "paper-money"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "playwright": "^1.64.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wippa-studios/OpenBettingExchange.git"
  },
  "homepage": "https://github.com/wippa-studios/OpenBettingExchange#readme",
  "bugs": {
    "url": "https://github.com/wippa-studios/OpenBettingExchange/issues"
  },
  "author": "wippa-studios",
  "private": false
}
